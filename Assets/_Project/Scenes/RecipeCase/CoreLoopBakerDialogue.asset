        character: {fileID: 11400000, guid: 44d7bb26bb567c7468bd4fdfbc84ca8b, type: 2}
        overrideName: 
        inheritCharacter: 0
        text: "\u0412\u0435\u0447\u0435\u0440\u043E\u043C \u0440\u0435\u0446\u0435\u043F\u0442 \u043B\u0435\u0436\u0430\u043B \u043D\u0430 \u0441\u0442\u043E\u043B\u0435. \u0423\u0442\u0440\u043E\u043C \u043E\u0441\u0442\u0430\u043B\u0430\u0441\u044C \u043E\u0434\u043D\u0430 \u043C\u0443\u043A\u0430. \u0427\u0442\u043E \u0432\u0430\u043C \u0443\u0434\u0430\u043B\u043E\u0441\u044C \u0443\u0437\u043D\u0430\u0442\u044C?"
        quest: {fileID: 0}
        clue: {fileID: 0}
        publishTalked: 0
        moodChange: 0
        nextNodeId:
          serializedVersion: 2
          Hash: 19216029f1ca91545003e7c376685d79
    - rid: 5539972265917808821
      type: {class: ChoiceNodeData, ns: _Project.Develop.Data.Dialogue, asm: Data}
      data:
        id:
          serializedVersion: 2
          Hash: 19216029f1ca91545003e7c376685d79
        options:
        - text: "\u0427\u0442\u043E \u0431\u044B\u043B\u043E \u0441\u043B\u044B\u0448\u043D\u043E \u0443 \u043E\u043A\u043D\u0430?"
          condition: 0
          character: {fileID: 0}
          moodThreshold: 0
          requiredClue: {fileID: 0}
          requiredHypothesis: {fileID: 0}
          nextNodeId:
            serializedVersion: 2
            Hash: f72f4d62b01a64ed0f0ecb7985fd96c5
        - text: "\u041B\u0438\u0441\u0442 \u0443\u043D\u0451\u0441 \u0441\u043A\u0432\u043E\u0437\u043D\u044F\u043A. \u041F\u043E\u0441\u043C\u043E\u0442\u0440\u0438\u0442\u0435 \u043F\u043E\u0434 \u0448\u043A\u0430\u0444\u043E\u043C."
          condition: 3
          character: {fileID: 0}
          moodThreshold: 0
          requiredClue: {fileID: 0}
          requiredHypothesis: {fileID: 11400000, guid: 0bcf329e7e07d8b48b5868751e23ed02, type: 2}
          nextNodeId:
            serializedVersion: 2
            Hash: ee48ae2889afc22335dcc331ecd61762
    - rid: 5539972265917808822
      type: {class: DialogueNodeData, ns: _Project.Develop.Data.Dialogue, asm: Data}
      data:
        id:
          serializedVersion: 2
          Hash: f72f4d62b01a64ed0f0ecb7985fd96c5
        character: {fileID: 11400000, guid: 44d7bb26bb567c7468bd4fdfbc84ca8b, type: 2}
        overrideName: 
        inheritCharacter: 0
        text: "Я как раз ставил пирог в печь, когда стукнула оконная рама. Обернулся — а в воздухе мука. Даже мятой от подоконника пахнуло."
        quest: {fileID: 0}
        clue: {fileID: 0}
        publishTalked: 0
        moodChange: 0
        nextNodeId:
          serializedVersion: 2
          Hash: 2d574651f601aa1a2f392da493ce1584
    - rid: 5539972265917808823
      type: {class: EndNodeData, ns: _Project.Develop.Data.Dialogue, asm: Data}
      data:
        id:
          serializedVersion: 2
          Hash: 2d574651f601aa1a2f392da493ce1584
        setDialogue: {fileID: 0}
    - rid: 5539972265917808824
      type: {class: DialogueNodeData, ns: _Project.Develop.Data.Dialogue, asm: Data}
      data:
        id:
          serializedVersion: 2
          Hash: ee48ae2889afc22335dcc331ecd61762
        character: {fileID: 11400000, guid: 44d7bb26bb567c7468bd4fdfbc84ca8b, type: 2}
        overrideName: 
        inheritCharacter: 0
        text: "\u0412\u043E\u0442 \u043C\u043E\u0439 \u0440\u0435\u0446\u0435\u043F\u0442! \u0411\u0443\u043C\u0430\u0433\u0430 \u0437\u0430\u0446\u0435\u043F\u0438\u043B\u0430\u0441\u044C \u0437\u0430 \u043D\u043E\u0436\u043A\u0443 \u0448\u043A\u0430\u0444\u0430. \u0421\u043F\u0430\u0441\u0438\u0431\u043E, \u0438\u043D\u0441\u043F\u0435\u043A\u0442\u043E\u0440!"
        quest: {fileID: 0}
        clue: {fileID: 0}
        publishTalked: 0
        moodChange: 0
