    - rid: 3967460749053264049
      type: {class: 'Constant`1[[System.String, mscorlib]]', ns: Unity.GraphToolkit.Editor, asm: UnityEditor.GraphToolkitModule}
      data:
        m_Value: "\u041E\u0445, \u0438\u043D\u0441\u043F\u0435\u043A\u0442\u043E\u0440. \u0411\u0435\u0434\u0430. \u0423 \u043C\u0435\u043D\u044F \u0438\u0441\u0447\u0435\u0437 \u043C\u043E\u0439 \u0444\u0438\u0440\u043C\u0435\u043D\u043D\u044B\u0439 <wave><highlight> \u0440\u0435\u0446\u0435\u043F\u0442 \u043F\u0438\u0440\u043E\u0433\u0430</highlight></wave>!\n<br> \u042F \u043E\u0441\u0442\u0430\u0432\u0438\u043B \u0435\u0433\u043E \u043D\u0430 \u0441\u0442\u043E\u043B\u0435, \u0430 \u043A\u043E\u0433\u0434\u0430 \u0432\u0435\u0440\u043D\u0443\u043B\u0441\u044F, \u043E\u043D \u0438\u0441\u0447\u0435\u0437! \u0418\u043B\u0438 \u044F \u0435\u0433\u043E \u0441\u0430\u043C \u0443\u0431\u0440\u0430\u043B... \u041D\u0435 \u043F\u043E\u043C\u043D\u044E. \u0413\u043E\u043B\u043E\u0432\u0430 \u043A\u0440\u0443\u0433\u043E\u043C"
